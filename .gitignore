# src/.gitignore
# ── Archivos temporales de Office ────────────────────────────────────────────
~$*

# ── Videos y archivos multimedia ─────────────────────────────────────────────
*.mp4
*.mov
*.avi
*.mkv
*.webm
Videos/

# ── Imágenes y logos (usar CDN o Supabase Storage en su lugar) ───────────────
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
Logo*
logo*

# ── Documentos de Office ──────────────────────────────────────────────────────
*.docx
*.xlsx
*.pptx
*.pdf
*.doc
*.xls

# ── Node / Vite ───────────────────────────────────────────────────────────────
node_modules/
dist/
.env
.env.local
.env.*.local

# ── Sistema operativo ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editores ──────────────────────────────────────────────────────────────────
.vscode/
*.swp
*.swo

# ── Backups generados manualmente ────────────────────────────────────────────
*_backup.txt
*_backup.jsx
*_backup.ts
operatorview_backup.txt

# ── Supabase local ────────────────────────────────────────────────────────────
.supabase/